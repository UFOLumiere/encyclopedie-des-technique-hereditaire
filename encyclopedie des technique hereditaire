const grid = document.getElementById("techniqueGrid");
const searchBar = document.getElementById("searchBar");
const resultCount = document.getElementById("resultCount");
const noResults = document.getElementById("noResults");
const clearSearch = document.getElementById("clearSearch");
const filters = document.querySelectorAll(".filter");

let activeFilter = "all";

function normalize(text) {
    return text
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");
}

function renderTechniques() {
    const query = normalize(searchBar.value.trim());

    const filtered = techniques.filter(item => {
        const searchable = normalize(
            `${item.name} ${item.category} ${item.clan} ${item.description}`
        );

        const matchesSearch = searchable.includes(query);
        const matchesFilter =
            activeFilter === "all" ||
            item.category === activeFilter;

        return matchesSearch && matchesFilter;
    });

    grid.innerHTML = filtered.map(item => `
        <article class="card">
            <div class="card-top">
                <div class="card-icon">${item.icon}</div>
                <span class="tag">${item.category}</span>
            </div>

            <h3>${item.name}</h3>
            <p>${item.description}</p>
            <div class="clan">${item.clan}</div>
        </article>
    `).join("");

    resultCount.textContent =
        `${filtered.length} pouvoir(s) trouvé(s) sur ${techniques.length}`;

    noResults.hidden = filtered.length !== 0;
}

searchBar.addEventListener("input", renderTechniques);

clearSearch.addEventListener("click", () => {
    searchBar.value = "";
    renderTechniques();
    searchBar.focus();
});

filters.forEach(button => {
    button.addEventListener("click", () => {
        filters.forEach(filter => filter.classList.remove("active"));

        button.classList.add("active");
        activeFilter = button.dataset.filter;

        renderTechniques();
    });
});

renderTechniques();

# 🍥 Naruto - Encyclopédie des pouvoirs

Site web consacré aux pouvoirs de l'univers Naruto.

## Fonctionnalités

- Barre de recherche instantanée.
- Filtres par catégorie.
- Fiches descriptives des techniques.
- Design sombre et orange.
- Compatible mobile et ordinateur.
- Compatible avec GitHub Pages.

## Installation

1. Télécharge ou clone le dépôt.
2. Garde les fichiers `index.html`, `style.css` et `script.js` dans le même dossier.
3. Ouvre `index.html` dans ton navigateur.

## Publication avec GitHub Pages

1. Ouvre les paramètres du dépôt GitHub.
2. Va dans Settings > Pages.
3. Choisis Deploy from a branch.
4. Sélectionne la branche main.
5. Sélectionne le dossier /(root).
6. Clique sur Save.

Ton site sera ensuite publié sur GitHub Pages.

## Crédits

