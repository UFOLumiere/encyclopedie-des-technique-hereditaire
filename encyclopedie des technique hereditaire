@import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Roboto:wght@400;500;700&display=swap');

:root {
    --background: #0d1018;
    --surface: #171c28;
    --surface-light: #202738;
    --orange: #ff873d;
    --orange-light: #ffb16e;
    --white: #f4f4f6;
    --muted: #a4aabb;
    --border: #30394a;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    background: var(--background);
    color: var(--white);
    font-family: 'Roboto', sans-serif;
    line-height: 1.6;
}

.hero {
    min-height: 440px;
    background:
        linear-gradient(90deg, rgba(13,16,24,.97), rgba(13,16,24,.7)),
        radial-gradient(circle at 80% 40%, #873c24, transparent 55%);
    border-bottom: 1px solid var(--border);
}

.navbar {
    max-width: 1150px;
    margin: auto;
    padding: 25px 25px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo, .footer-logo {
    font-family: 'Rajdhani', sans-serif;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 2px;
    color: white;
    text-decoration: none;
}

.logo span, .footer-logo span {
    color: var(--orange);
}

.nav-link {
    color: var(--muted);
    text-decoration: none;
}

.nav-link:hover {
    color: var(--orange);
}

.hero-content {
    max-width: 1150px;
    margin: auto;
    padding: 75px 25px 90px;
}

.eyebrow {
    color: var(--orange);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 4px;
    margin-bottom: 12px;
}

.hero h1 {
    font-family: 'Rajdhani', sans-serif;
    font-size: clamp(38px, 7vw, 68px);
    line-height: 1.1;
    max-width: 700px;
    margin-bottom: 20px;
}

.hero h1 span {
    color: var(--orange);
}

.hero-content > p:not(.eyebrow) {
    color: var(--muted);
    max-width: 500px;
    margin-bottom: 30px;
}

.hero-button {
    display: inline-block;
    background: var(--orange);
    color: #17120f;
    padding: 12px 22px;
    border-radius: 7px;
    text-decoration: none;
    font-weight: 700;
    transition: .2s;
}

.hero-button:hover {
    background: var(--orange-light);
    transform: translateY(-2px);
}

main {
    max-width: 1150px;
    margin: auto;
    padding: 60px 25px;
}

.search-section {
    text-align: center;
    margin-bottom: 45px;
}

.search-section h2 {
    font-family: 'Rajdhani', sans-serif;
    font-size: 40px;
}

.search-section > p:not(.eyebrow) {
    color: var(--muted);
}

.search-box {
    max-width: 680px;
    margin: 25px auto 12px;
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0 16px;
    border-radius: 10px;
    transition: .2s;
}

.search-box:focus-within {
    border-color: var(--orange);
    box-shadow: 0 0 15px #ff873d20;
}

.search-box span {
    font-size: 28px;
    color: var(--orange);
}

.search-box input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    padding: 17px 0;
    color: white;
    font-size: 15px;
}

.search-box input::placeholder {
    color: #7f8799;
}

.search-box button {
    background: transparent;
    border: none;
    color: var(--muted);
    font-size: 25px;
    cursor: pointer;
}

#resultCount {
    color: var(--orange-light);
    font-size: 13px;
    margin-bottom: 22px;
}

.filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 9px;
}

.filter {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    padding: 8px 15px;
    border-radius: 20px;
    cursor: pointer;
    transition: .2s;
}

.filter:hover, .filter.active {
    background: var(--orange);
    color: #17120f;
    border-color: var(--orange);
    font-weight: 700;
}

.technique-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(245px, 1fr));
    gap: 18px;
}

.card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 22px;
    transition: .2s;
    animation: appear .3s ease;
}

.card:hover {
    transform: translateY(-5px);
    border-color: var(--orange);
    background: var(--surface-light);
}

.card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 15px;
}

.card-icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #ff873d20;
    color: var(--orange);
    font-size: 22px;
}

.tag {
    font-size: 11px;
    color: var(--orange-light);
    background: #ff873d18;
    border: 1px solid #ff873d40;
    padding: 5px 9px;
    border-radius: 20px;
}

.card h3 {
    font-family: 'Rajdhani', sans-serif;
    font-size: 24px;
    color: var(--white);
    margin-bottom: 8px;
}

.card p {
    color: var(--muted);
    font-size: 14px;
}

.card .clan {
    color: var(--orange-light);
    font-size: 12px;
    margin-top: 15px;
}

.no-results {
    text-align: center;
    padding: 70px 20px;
}

.no-results span {
    font-size: 45px;
    color: var(--orange);
}

.no-results p {
    color: var(--muted);
}

footer {
    text-align: center;
    padding: 35px 20px;
    background: #090b11;
    border-top: 1px solid var(--border);
}

.footer-logo {
    margin-bottom: 10px;
}

footer p {
    color: var(--muted);
    font-size: 13px;
}

footer .copyright {
    margin-top: 12px;
    font-size: 11px;
}

@keyframes appear {
    from {
        opacity: 0;
        transform: translateY(8px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (max-width: 600px) {
    .hero {
        min-height: 380px;
    }

    .hero-content {
        padding-top: 55px;
    }

    main {
        padding: 40px 16px;
    }

    .search-section h2 {
        font-size: 34px;
    }

    .technique-grid {
        grid-template-columns: 1fr;
    }

    .filters {
        gap: 7px;
    }

    .filter {
        font-size: 12px;
        padding: 7px 11px;
    }
}

